{
  "_meta": {
    "source": "UCI Machine Learning Repository dataset 365 (Polish Companies Bankruptcy Data), attribute list as published on the UCI page and reproduced in IEEE DataPort and Kaggle 'Companies bankruptcy forecast' documentation.",
    "note": "Formulas are preserved from the published attribute list. Some attributes are not computable from a single fiscal year of pipeline line items (X24 requires a 3-year gross profit series); they are omitted by ratio_extractor and documented in feature_map_notes.md."
  },
  "X1":  {"formula": "net profit / total assets", "requires": ["net_profit", "total_assets"]},
  "X2":  {"formula": "total liabilities / total assets", "requires": ["total_liabilities", "total_assets"]},
  "X3":  {"formula": "working capital / total assets", "requires": ["working_capital", "total_assets"]},
  "X4":  {"formula": "current assets / short-term liabilities", "requires": ["current_assets", "current_liabilities"]},
  "X5":  {"formula": "[(cash + short-term securities + receivables - short-term liabilities) / (operating expenses - depreciation)] * 365", "requires": ["cash_and_short_term", "receivables", "current_liabilities", "operating_expenses", "depreciation"]},
  "X6":  {"formula": "retained earnings / total assets", "requires": ["retained_earnings", "total_assets"]},
  "X7":  {"formula": "EBIT / total assets", "requires": ["ebit", "total_assets"]},
  "X8":  {"formula": "book value of equity / total liabilities", "requires": ["equity", "total_liabilities"]},
  "X9":  {"formula": "sales / total assets", "requires": ["revenue", "total_assets"]},
  "X10": {"formula": "equity / total assets", "requires": ["equity", "total_assets"]},
  "X11": {"formula": "(gross profit + extraordinary items + financial expenses) / total assets", "requires": ["gross_profit", "finance_expense", "total_assets"]},
  "X12": {"formula": "gross profit / short-term liabilities", "requires": ["gross_profit", "current_liabilities"]},
  "X13": {"formula": "(gross profit + depreciation) / sales", "requires": ["gross_profit", "depreciation", "revenue"]},
  "X14": {"formula": "(gross profit + interest) / total assets", "requires": ["gross_profit", "interest_expense", "total_assets"]},
  "X15": {"formula": "(total liabilities * 365) / (gross profit + depreciation)", "requires": ["total_liabilities", "gross_profit", "depreciation"]},
  "X16": {"formula": "(gross profit + depreciation) / total liabilities", "requires": ["gross_profit", "depreciation", "total_liabilities"]},
  "X17": {"formula": "total assets / total liabilities", "requires": ["total_assets", "total_liabilities"]},
  "X18": {"formula": "gross profit / total assets", "requires": ["gross_profit", "total_assets"]},
  "X19": {"formula": "gross profit / sales", "requires": ["gross_profit", "revenue"]},
  "X20": {"formula": "(inventory * 365) / sales", "requires": ["inventory", "revenue"]},
  "X21": {"formula": "sales (n) / sales (n-1)", "requires": ["revenue", "revenue_prior_year"]},
  "X22": {"formula": "profit on operating activities / total assets", "requires": ["operating_profit", "total_assets"]},
  "X23": {"formula": "net profit / sales", "requires": ["net_profit", "revenue"]},
  "X24": {"formula": "gross profit (in 3 years) / total assets", "requires": ["gross_profit_3y", "total_assets"], "multi_year": true},
  "X25": {"formula": "(equity - share capital) / total assets", "requires": ["equity", "share_capital", "total_assets"]},
  "X26": {"formula": "(net profit + depreciation) / total liabilities", "requires": ["net_profit", "depreciation", "total_liabilities"]},
  "X27": {"formula": "profit on operating activities / financial expenses", "requires": ["operating_profit", "finance_expense"]},
  "X28": {"formula": "working capital / fixed assets", "requires": ["working_capital", "fixed_assets"]},
  "X29": {"formula": "logarithm of total assets", "requires": ["total_assets"]},
  "X30": {"formula": "(total liabilities - cash) / sales", "requires": ["total_liabilities", "cash", "revenue"]},
  "X31": {"formula": "(gross profit + interest) / sales", "requires": ["gross_profit", "interest_expense", "revenue"]},
  "X32": {"formula": "(current liabilities * 365) / cost of products sold", "requires": ["current_liabilities", "cogs"]},
  "X33": {"formula": "operating expenses / short-term liabilities", "requires": ["operating_expenses", "current_liabilities"]},
  "X34": {"formula": "operating expenses / total liabilities", "requires": ["operating_expenses", "total_liabilities"]},
  "X35": {"formula": "profit on sales / total assets", "requires": ["gross_profit", "total_assets"]},
  "X36": {"formula": "total sales / total assets", "requires": ["revenue", "total_assets"]},
  "X37": {"formula": "(current assets - inventories) / long-term liabilities", "requires": ["current_assets", "inventory", "long_term_liabilities"]},
  "X38": {"formula": "constant capital / total assets", "requires": ["constant_capital", "total_assets"]},
  "X39": {"formula": "profit on sales / sales", "requires": ["gross_profit", "revenue"]},
  "X40": {"formula": "(current assets - inventory - receivables) / short-term liabilities", "requires": ["current_assets", "inventory", "receivables", "current_liabilities"]},
  "X41": {"formula": "total liabilities / [(profit on operating activities + depreciation) * (12/365)]", "requires": ["total_liabilities", "operating_profit", "depreciation"]},
  "X42": {"formula": "profit on operating activities / sales", "requires": ["operating_profit", "revenue"]},
  "X43": {"formula": "rotation receivables + inventory turnover in days", "requires": ["receivables", "inventory", "revenue", "cogs"]},
  "X44": {"formula": "(receivables * 365) / sales", "requires": ["receivables", "revenue"]},
  "X45": {"formula": "net profit / inventory", "requires": ["net_profit", "inventory"]},
  "X46": {"formula": "(current assets - inventory) / short-term liabilities", "requires": ["current_assets", "inventory", "current_liabilities"]},
  "X47": {"formula": "(inventory * 365) / cost of products sold", "requires": ["inventory", "cogs"]},
  "X48": {"formula": "EBITDA (profit on operating activities - depreciation) / total assets", "requires": ["operating_profit", "depreciation", "total_assets"]},
  "X49": {"formula": "EBITDA (profit on operating activities - depreciation) / sales", "requires": ["operating_profit", "depreciation", "revenue"]},
  "X50": {"formula": "current assets / total liabilities", "requires": ["current_assets", "total_liabilities"]},
  "X51": {"formula": "short-term liabilities / total assets", "requires": ["current_liabilities", "total_assets"]},
  "X52": {"formula": "(short-term liabilities * 365) / cost of products sold", "requires": ["current_liabilities", "cogs"]},
  "X53": {"formula": "equity / fixed assets", "requires": ["equity", "fixed_assets"]},
  "X54": {"formula": "constant capital / fixed assets", "requires": ["constant_capital", "fixed_assets"]},
  "X55": {"formula": "working capital", "requires": ["working_capital"]},
  "X56": {"formula": "(sales - cost of products sold) / sales", "requires": ["revenue", "cogs"]},
  "X57": {"formula": "(current assets - inventory - short-term liabilities) / (sales - gross profit - depreciation)", "requires": ["current_assets", "inventory", "current_liabilities", "revenue", "gross_profit", "depreciation"]},
  "X58": {"formula": "total costs / total sales", "requires": ["operating_expenses", "revenue"]},
  "X59": {"formula": "long-term liabilities / equity", "requires": ["long_term_liabilities", "equity"]},
  "X60": {"formula": "sales / inventory", "requires": ["revenue", "inventory"]},
  "X61": {"formula": "sales / receivables", "requires": ["revenue", "receivables"]},
  "X62": {"formula": "(short-term liabilities * 365) / sales", "requires": ["current_liabilities", "revenue"]},
  "X63": {"formula": "sales / short-term liabilities", "requires": ["revenue", "current_liabilities"]},
  "X64": {"formula": "sales / fixed assets", "requires": ["revenue", "fixed_assets"]}
}
